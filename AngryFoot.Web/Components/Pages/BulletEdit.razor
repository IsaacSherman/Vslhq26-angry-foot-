@page "/bullets/edit"
@page "/bullets/edit/{BulletId:guid}"
@using AngryFoot.Contracts
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject NavigationManager Navigation
@inject ILogger<BulletEdit> Logger

<PageTitle>Bullet Editor</PageTitle>

<h1>@(IsCreate ? "Create Bullet" : "Edit Bullet")</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="mb-3">
    <label class="form-label">Bullet Text</label>
    <textarea class="form-control" rows="6" @bind="bulletText"></textarea>
</div>

<div class="mb-3">
    <label class="form-label">Employer</label>
    <input class="form-control" list="employer-options" placeholder="Which employer does this bullet belong to?" @bind="sourceEmployer" />
    <datalist id="employer-options">
        @foreach (var employer in knownEmployers)
        {
            <option value="@employer" />
        }
    </datalist>
    <div class="form-text">Used to group this bullet under the matching work history entry on generated resumes.</div>
</div>

<div class="mb-3">
    <button class="btn btn-outline-primary me-3" @onclick="RewriteAsync" disabled="@(isRewriting || isSaving)">
        @if (isRewriting)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        Rewrite Suggestion
    </button>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="deep-review" @bind="deepReview" disabled="@(isRewriting || isSaving)" />
        <label class="form-check-label" for="deep-review">Deep review</label>
    </div>
    <div class="form-text">
        Deep review has a second agent critique the rewrite, lets the first agent revise it, and a third merge the results.
        Three extra AI calls, so expect roughly four times the wait - and a choice of versions instead of one answer.
    </div>
</div>

<WorkingIndicator Visible="@isRewriting" Message="@RewriteProgressMessage" />
<WorkingIndicator Visible="@isSaving" Message="Saving and enriching the bullet with AI-extracted skills, technologies, and tags..." />

@if (rewriteResult is not null)
{
    <DraftVersionPicker Refinement="@rewriteResult.Refinement"
                        Title="Deep review: pick a rewrite"
                        SelectedLabel="@selectedVersionLabel"
                        SelectedLabelChanged="OnVersionSelected" />

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Suggested Rewrite</h5>
            <p class="card-text">@SuggestedText</p>

            @if (rewriteResult.Suggestions.Count > 0)
            {
                <h6>Suggestions</h6>
                <ul>
                    @foreach (var suggestion in rewriteResult.Suggestions)
                    {
                        <li>@suggestion</li>
                    }
                </ul>
            }

            <button class="btn btn-sm btn-success" @onclick="ApplyRewrite">Use Suggested Rewrite</button>
        </div>
    </div>
}

<div>
    <button class="btn btn-primary me-2" @onclick="SaveAsync" disabled="@(isSaving || isRewriting)">
        @if (isSaving)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        Save
    </button>
    <button class="btn btn-outline-secondary" @onclick="Back" disabled="@isSaving">Back</button>
</div>

@code {
    [Parameter]
    public Guid? BulletId { get; set; }

    private string bulletText = string.Empty;
    private string? sourceEmployer;
    private List<string> knownEmployers = [];
    private bool isSaving;
    private bool isRewriting;
    private bool deepReview;
    private string? errorMessage;
    private RewriteBulletResponse? rewriteResult;
    private string? selectedVersionLabel;

    private bool IsCreate => !BulletId.HasValue;

    /// <summary>
    /// The text the Use button applies: the version the user picked, or the single rewrite when
    /// deep review was off.
    /// </summary>
    private string SuggestedText
    {
        get
        {
            if (rewriteResult is null)
            {
                return string.Empty;
            }

            var version = rewriteResult.Refinement?.Versions
                .FirstOrDefault(x => x.Label == selectedVersionLabel);

            return version?.Text ?? rewriteResult.RewrittenText;
        }
    }

    private string RewriteProgressMessage => deepReview
        ? "Drafting a rewrite, then critiquing, revising, and merging it. Four AI calls, so this usually takes a couple of minutes."
        : "Asking the AI for an improved rewrite and suggestions...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ApiClient.GetProfileAsync();
            knownEmployers = profile.WorkHistory
                .Select(x => x.Employer)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            // Employer suggestions are optional; the editor works without them.
            Logger.LogWarning(ex, "Failed to load employer suggestions from the profile.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        errorMessage = null;
        rewriteResult = null;
        selectedVersionLabel = null;
        if (BulletId is null)
        {
            bulletText = string.Empty;
            sourceEmployer = null;
            return;
        }

        var bullet = await ApiClient.GetBulletAsync(BulletId.Value);
        if (bullet is null)
        {
            errorMessage = "Bullet not found.";
            return;
        }

        bulletText = bullet.BulletText;
        sourceEmployer = bullet.SourceEmployer;
    }

    private async Task RewriteAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(bulletText))
        {
            errorMessage = "Bullet text is required.";
            return;
        }

        isRewriting = true;

        try
        {
            rewriteResult = await ApiClient.RewriteBulletAsync(bulletText.Trim(), deepReview);
            selectedVersionLabel = rewriteResult.Refinement?.RecommendedLabel;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRewriting = false;
        }
    }

    private void OnVersionSelected(string label)
    {
        selectedVersionLabel = label;
    }

    private void ApplyRewrite()
    {
        var suggested = SuggestedText;
        if (!string.IsNullOrWhiteSpace(suggested))
        {
            bulletText = suggested;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(bulletText))
        {
            errorMessage = "Bullet text is required.";
            return;
        }

        isSaving = true;

        try
        {
            var employer = string.IsNullOrWhiteSpace(sourceEmployer) ? null : sourceEmployer.Trim();
            if (BulletId is null)
            {
                await ApiClient.CreateBulletAsync(bulletText.Trim(), employer);
            }
            else
            {
                var updated = await ApiClient.UpdateBulletAsync(BulletId.Value, bulletText.Trim(), employer);
                if (updated is null)
                {
                    errorMessage = "Bullet not found.";
                    return;
                }
            }

            Navigation.NavigateTo("/bullets");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/bullets");
    }
}
