@page "/bullets/edit"
@page "/bullets/edit/{BulletId:guid}"
@using AngryFoot.Contracts
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject NavigationManager Navigation
@inject ILogger<BulletEdit> Logger

<PageTitle>Bullet Editor</PageTitle>

<h1>@(IsCreate ? "Create Bullet" : "Edit Bullet")</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="mb-3">
    <label class="form-label">Bullet Text</label>
    <textarea class="form-control" rows="6" @bind="bulletText"></textarea>
    <div class="mt-2">
        <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="ReassessAsync"
                disabled="@(isAssessing || isSaving || isRewriting || string.IsNullOrWhiteSpace(bulletText))">
            @if (isAssessing)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            Reassess
        </button>
        @if (isQualityStale)
        {
            <span class="text-muted small ms-2">Scored against earlier wording.</span>
        }
        <BulletQualityPanel Quality="@quality"
                            CanAcknowledge="@(!IsCreate)"
                            Disabled="@(isAssessing || isSaving)"
                            AcknowledgementsChanged="OnAcknowledgementsChanged" />
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Employer</label>
    <input class="form-control" list="employer-options" placeholder="Which employer does this bullet belong to?" @bind="sourceEmployer" />
    <datalist id="employer-options">
        @foreach (var employer in knownEmployers)
        {
            <option value="@employer" />
        }
    </datalist>
    <div class="form-text">Used to group this bullet under the matching work history entry on generated resumes.</div>
</div>

<div class="mb-3">
    <button class="btn btn-outline-primary me-3" @onclick="RewriteAsync" disabled="@(isRewriting || isSaving)">
        @if (isRewriting)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        Rewrite Suggestion
    </button>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="deep-review" @bind="deepReview" disabled="@(isRewriting || isSaving)" />
        <label class="form-check-label" for="deep-review">Deep review</label>
    </div>
    <div class="form-text">
        Deep review has a second agent critique the rewrite, lets the first agent revise it, and a third merge the results.
        Three extra AI calls, so expect roughly four times the wait - and a choice of versions instead of one answer.
        It pauses after the critique so you can correct anything the reviewer misread.
    </div>
</div>

<WorkingIndicator Visible="@isRewriting" Message="@RewriteProgressMessage" />
<WorkingIndicator Visible="@isCompleting" Message="Revising and merging with your guidance. Two AI calls, usually under a minute." />
<WorkingIndicator Visible="@isSaving" Message="Saving and enriching the bullet with AI-extracted skills, technologies, and tags..." />

@if (critique is not null)
{
    <div class="card border-primary mb-3">
        <div class="card-header">The reviewer's take &mdash; anything it got wrong?</div>
        <div class="card-body">
            <h6>Your bullet, rewritten (v1)</h6>
            <p>@critique.Draft</p>

            <h6>What the reviewer said</h6>
            <p style="white-space: pre-wrap;">@critique.Critique</p>

            @if (!string.IsNullOrWhiteSpace(critique.Alternative))
            {
                <h6>The reviewer's own attempt (v2)</h6>
                <p>@critique.Alternative</p>
            }

            <label class="form-label" for="guidance">Your guidance (optional)</label>
            <textarea class="form-control" id="guidance" rows="3" @bind="guidance" disabled="@isCompleting"
                      placeholder="e.g. &quot;systems&quot; here means HVAC controls, not software - the reviewer read it wrong"></textarea>
            <div class="form-text mb-3">
                Anything you write here is treated as fact by the remaining agents and outranks the critique.
                Leave it blank to carry on without it.
            </div>

            <button class="btn btn-primary" @onclick="CompleteRewriteAsync" disabled="@isCompleting">
                @if (isCompleting)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Revise and merge
            </button>
        </div>
    </div>
}

@if (rewriteResult is not null)
{
    <DraftVersionPicker Refinement="@rewriteResult.Refinement"
                        Title="Deep review: pick a rewrite"
                        SelectedLabel="@selectedVersionLabel"
                        SelectedLabelChanged="OnVersionSelected" />

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Suggested Rewrite</h5>
            <p class="card-text">@SuggestedText</p>

            @if (rewriteResult.Suggestions.Count > 0)
            {
                <h6>Suggestions</h6>
                <ul>
                    @foreach (var suggestion in rewriteResult.Suggestions)
                    {
                        <li>@suggestion</li>
                    }
                </ul>
            }

            <button class="btn btn-sm btn-success" @onclick="ApplyRewrite">Use Suggested Rewrite</button>
        </div>
    </div>
}

@if (!IsCreate)
{
    <BulletRevisionsPanel BulletId="@BulletId" BulletChanged="OnPromotedRevision" />
}

<div>
    <button class="btn btn-primary me-2" @onclick="SaveAsync" disabled="@(isSaving || isRewriting)">
        @if (isSaving)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        Save
    </button>
    <button class="btn btn-outline-secondary" @onclick="Back" disabled="@isSaving">Back</button>
</div>

@code {
    [Parameter]
    public Guid? BulletId { get; set; }

    private string bulletText = string.Empty;
    private string? sourceEmployer;
    private List<string> knownEmployers = [];
    private bool isSaving;
    private bool isRewriting;
    private bool isCompleting;
    private bool deepReview;
    private string? errorMessage;
    private RewriteBulletResponse? rewriteResult;
    private BulletRewriteCritiqueResponse? critique;
    private string? guidance;
    private string? selectedVersionLabel;
    private BulletQualityDto? quality;
    private bool isAssessing;

    /// <summary>
    /// Enrichment from the last Reassess. Handed to Save so a bullet that has already been through
    /// the tagger is not sent through it twice; the API ignores it if the text has moved on.
    /// </summary>
    private BulletTaggingDto? assessedTagging;

    /// <summary>The wording <see cref="quality"/> describes, so the panel can admit when it is behind.</summary>
    private string? scoredText;

    private bool isQualityStale => quality is not null && !string.Equals(scoredText, bulletText, StringComparison.Ordinal);

    private bool IsCreate => !BulletId.HasValue;

    /// <summary>
    /// A promoted version becomes the bullet's text, so the editor has to show the new wording
    /// rather than leave the user editing what they just replaced.
    /// </summary>
    private void OnPromotedRevision(BulletDto bullet)
    {
        bulletText = bullet.BulletText;
        sourceEmployer = bullet.SourceEmployer;
        ApplyQuality(bullet);
    }

    private void ApplyQuality(BulletDto bullet)
    {
        quality = bullet.Quality;
        scoredText = bullet.BulletText;
        // The bullet was tagged server-side by whatever wrote it; nothing local to reuse.
        assessedTagging = null;
    }

    /// <summary>
    /// Two of the six signals come from enrichment rather than the text, so a full score needs an AI
    /// call. Running it here rather than on save means the score can be seen before committing to
    /// the wording, and the tagging is kept so the save that follows does not repeat the call.
    /// </summary>
    private async Task ReassessAsync()
    {
        if (string.IsNullOrWhiteSpace(bulletText))
        {
            return;
        }

        errorMessage = null;
        isAssessing = true;

        try
        {
            var settled = quality?.Signals.Where(x => x.IsDeclared).Select(x => x.Name).ToArray() ?? [];
            var assessment = await ApiClient.AssessBulletAsync(bulletText.Trim(), settled);

            quality = assessment.Quality;
            assessedTagging = assessment.Tagging;
            scoredText = bulletText.Trim();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isAssessing = false;
        }
    }

    private async Task OnAcknowledgementsChanged(IReadOnlyList<string> signals)
    {
        if (BulletId is null)
        {
            return;
        }

        errorMessage = null;

        try
        {
            var updated = await ApiClient.SetBulletQualityAcknowledgementsAsync(BulletId.Value, signals);
            if (updated is not null)
            {
                ApplyQuality(updated);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// The text the Use button applies: the version the user picked, or the single rewrite when
    /// deep review was off.
    /// </summary>
    private string SuggestedText
    {
        get
        {
            if (rewriteResult is null)
            {
                return string.Empty;
            }

            var version = rewriteResult.Refinement?.Versions
                .FirstOrDefault(x => x.Label == selectedVersionLabel);

            return version?.Text ?? rewriteResult.RewrittenText;
        }
    }

    private string RewriteProgressMessage => deepReview
        ? "Drafting a rewrite and having it reviewed. Two AI calls, then it pauses for your input."
        : "Asking the AI for an improved rewrite and suggestions...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ApiClient.GetProfileAsync();
            knownEmployers = profile.WorkHistory
                .Select(x => x.Employer)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            // Employer suggestions are optional; the editor works without them.
            Logger.LogWarning(ex, "Failed to load employer suggestions from the profile.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        errorMessage = null;
        rewriteResult = null;
        critique = null;
        guidance = null;
        selectedVersionLabel = null;
        if (BulletId is null)
        {
            bulletText = string.Empty;
            sourceEmployer = null;
            quality = null;
            scoredText = null;
            assessedTagging = null;
            return;
        }

        var bullet = await ApiClient.GetBulletAsync(BulletId.Value);
        if (bullet is null)
        {
            errorMessage = "Bullet not found.";
            return;
        }

        bulletText = bullet.BulletText;
        sourceEmployer = bullet.SourceEmployer;
        ApplyQuality(bullet);
    }

    private async Task RewriteAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(bulletText))
        {
            errorMessage = "Bullet text is required.";
            return;
        }

        isRewriting = true;
        rewriteResult = null;
        critique = null;
        guidance = null;

        try
        {
            if (deepReview)
            {
                // Stop after the critique so the user can correct a misreading before the
                // revision and synthesis stages bake it in.
                critique = await ApiClient.CritiqueBulletRewriteAsync(bulletText.Trim());
                if (critique is not null)
                {
                    return;
                }
                // No AI draft to critique; fall through to the plain heuristic rewrite.
            }

            rewriteResult = await ApiClient.RewriteBulletAsync(bulletText.Trim(), deepReview: false);
            selectedVersionLabel = rewriteResult.Refinement?.RecommendedLabel;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRewriting = false;
        }
    }

    private async Task CompleteRewriteAsync()
    {
        if (critique is null)
        {
            return;
        }

        errorMessage = null;
        isCompleting = true;

        try
        {
            rewriteResult = await ApiClient.CompleteBulletRewriteAsync(new CompleteBulletRewriteRequest(
                critique.OriginalText,
                critique.Draft,
                critique.Critique,
                critique.Alternative,
                critique.Suggestions,
                guidance));

            selectedVersionLabel = rewriteResult.Refinement?.RecommendedLabel;
            critique = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCompleting = false;
        }
    }

    private void OnVersionSelected(string label)
    {
        selectedVersionLabel = label;
    }

    private void ApplyRewrite()
    {
        var suggested = SuggestedText;
        if (!string.IsNullOrWhiteSpace(suggested))
        {
            bulletText = suggested;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(bulletText))
        {
            errorMessage = "Bullet text is required.";
            return;
        }

        isSaving = true;

        try
        {
            var employer = string.IsNullOrWhiteSpace(sourceEmployer) ? null : sourceEmployer.Trim();
            if (BulletId is null)
            {
                await ApiClient.CreateBulletAsync(bulletText.Trim(), employer, assessedTagging);
            }
            else
            {
                var updated = await ApiClient.UpdateBulletAsync(BulletId.Value, bulletText.Trim(), employer, assessedTagging);
                if (updated is null)
                {
                    errorMessage = "Bullet not found.";
                    return;
                }
            }

            Navigation.NavigateTo("/bullets");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/bullets");
    }
}
