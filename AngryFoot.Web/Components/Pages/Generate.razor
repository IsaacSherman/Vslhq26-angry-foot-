@page "/generate"
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Generate</PageTitle>

<h1>Generate Resume & Cover Letter</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="btn-group mb-3" role="group" aria-label="Generation mode">
            <input type="radio" class="btn-check" name="generation-mode" id="mode-tailored" autocomplete="off"
                   checked="@(!isGeneric)" disabled="@isWorking" @onchange="() => SetGeneric(false)" />
            <label class="btn btn-outline-primary" for="mode-tailored">Tailored to a posting</label>

            <input type="radio" class="btn-check" name="generation-mode" id="mode-generic" autocomplete="off"
                   checked="@isGeneric" disabled="@isWorking" @onchange="() => SetGeneric(true)" />
            <label class="btn btn-outline-primary" for="mode-generic">Generic (for a recruiter)</label>
        </div>

        @if (isGeneric)
        {
            <div class="alert alert-secondary py-2">
                No posting: this picks the strongest bullets in your library and spreads them across as many
                skills, technologies, and employers as it can. It is not tailored, and a resume written against
                a real posting will beat it — use this when you need something to hand a recruiter today.
            </div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@(isGeneric ? "Target Job Title (optional)" : "Job Title (optional)")</label>
                <input class="form-control" @bind="jobTitle" />
                <div class="form-text">
                    @(isGeneric
                        ? "The role you are aiming at. Shapes the wording; no posting is invented from it."
                        : "Used to map the role to an occupation for the benchmark below.")
                </div>
            </div>
            @if (isGeneric)
            {
                <div class="col-md-6">
                    <label class="form-label">Written For</label>
                    <select class="form-select" @bind="audience">
                        <option value="@AngryFoot.Contracts.ResumeAudienceDto.Recruiter">Recruiter</option>
                        <option value="@AngryFoot.Contracts.ResumeAudienceDto.HiringManager">Hiring manager</option>
                        <option value="@AngryFoot.Contracts.ResumeAudienceDto.TechnicalLeader">Technical manager or lead</option>
                        <option value="@AngryFoot.Contracts.ResumeAudienceDto.Executive">Executive</option>
                    </select>
                    <div class="form-text">Changes how bullets are worded, never which ones are picked.</div>
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <label class="form-label">Company (optional)</label>
                    <input class="form-control" @bind="company" />
                </div>
            }
            <div class="col-md-3">
                <label class="form-label">Max Bullets</label>
                <input class="form-control" type="number" min="1" max="20" @bind="maxBullets" />
            </div>
            @if (!isGeneric)
            {
                <div class="col-12">
                    <label class="form-label">Job Description</label>
                    <textarea class="form-control" rows="10" @bind="jobDescription"></textarea>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Guidance for the AI (optional)</label>
                <textarea class="form-control" rows="3" @bind="guidance"
                          placeholder="Clarify anything ambiguous in your bullets - e.g. &quot;'systems' means HVAC controls, not software&quot;, or &quot;ACME was a 4-person startup, not the toy company&quot;."></textarea>
                <div class="form-text">
                    Treated as fact by every AI stage, with or without deep review. Use it when a bullet reads one way to you
                    and another way to a stranger.
                </div>
            </div>
        </div>

        <div class="mt-3">
            @if (!isGeneric)
            {
                <button class="btn btn-secondary me-2" @onclick="AnalyzeAsync" disabled="@isWorking">
                    @if (isAnalyzing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    Analyze
                </button>
            }
            <button class="btn btn-primary me-3" @onclick="GenerateAsync" disabled="@isWorking">
                @if (isGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Generate
            </button>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="deep-review" @bind="deepReview" disabled="@isWorking" />
                <label class="form-check-label" for="deep-review">Deep review</label>
            </div>
            <div class="form-text">
                @if (isGeneric)
                {
                    @("Deep review critiques, revises, and merges the bullet rewrites, then lets you pick between the versions. "
                      + "It can also reorder your bullets and swap in stronger ones the ranker left out. "
                      + "Three extra AI calls, since a generic resume has no cover letter to refine.")
                }
                else
                {
                    @("Deep review critiques, revises, and merges both the bullet rewrites and the cover letter, then lets you "
                      + "pick between the versions. It can also reorder your bullets and swap in stronger ones the ranker left out. "
                      + "Six extra AI calls, so generation takes several minutes instead of 30-90 seconds.")
                }
            </div>
        </div>
    </div>
</div>

<WorkingIndicator Visible="@isAnalyzing" Message="Linking this posting's requirements to the bullets in your library. This usually takes under a minute." />
<WorkingIndicator Visible="@isGenerating" Message="@GenerateProgressMessage" />

<EvidenceCoveragePanel Coverage="@coverage" Title="@coverageTitle" />

<GenerationExplanationPanel Explanation="@explanation" IsGeneric="@resultIsGeneric" />

<OccupationBenchmarkPanel Benchmark="@benchmark" />

@if (analysis is not null)
{
    <details class="card mb-3">
        <summary class="card-header" style="cursor: pointer;">Extracted Job Requirements</summary>
        <div class="card-body">
            <p><strong>Inferred Title:</strong> @analysis.InferredTitle</p>
            <p><strong>Inferred Seniority:</strong> @analysis.InferredSeniority</p>
            <p><strong>Required Skills:</strong> @string.Join(", ", analysis.RequiredSkills)</p>
            <p><strong>Preferred Skills:</strong> @string.Join(", ", analysis.PreferredSkills)</p>
            <p><strong>Technologies:</strong> @string.Join(", ", analysis.Technologies)</p>
            <p><strong>Experience Themes:</strong> @string.Join(", ", analysis.ExperienceThemes)</p>
        </div>
    </details>
}

@if (result is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="mb-0">Generated Output</h3>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CopyResumeAsync">Copy Resume</button>
            @if (!resultIsGeneric)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="CopyCoverLetterAsync">Copy Cover Letter</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(selectionError))
    {
        <div class="alert alert-warning">@selectionError</div>
    }

    <div class="row g-3">
        @* A generic resume has no cover letter to sit beside, so the resume takes the whole row. *@
        <div class="@(resultIsGeneric ? "col-12" : "col-md-6")">
            <DraftVersionPicker Refinement="@result.ResumeRefinement"
                                Title="Deep review: pick a resume"
                                SelectedLabel="@resumeVersionLabel"
                                Disabled="@isSavingSelection"
                                SelectedLabelChanged="OnResumeVersionSelected" />
            <MarkdownPane Title="Resume" Markdown="@ResumeMarkdown" Rows="24" />
        </div>
        @if (!resultIsGeneric)
        {
            <div class="col-md-6">
                <DraftVersionPicker Refinement="@result.CoverLetterRefinement"
                                    Title="Deep review: pick a cover letter"
                                    SelectedLabel="@coverLetterVersionLabel"
                                    Disabled="@isSavingSelection"
                                    SelectedLabelChanged="OnCoverLetterVersionSelected" />
                <MarkdownPane Title="Cover Letter" Markdown="@CoverLetterMarkdown" Rows="24" />
            </div>
        }
    </div>
}

@code {
    private string? jobTitle;
    private string? company;
    private string jobDescription = string.Empty;
    private string? guidance;
    private int maxBullets = 10;
    private bool isGeneric;
    private AngryFoot.Contracts.ResumeAudienceDto audience = AngryFoot.Contracts.ResumeAudienceDto.Recruiter;

    // Read from the result rather than from the form, so flipping the mode after a generation does
    // not relabel the document already on screen.
    private bool resultIsGeneric;

    private bool isAnalyzing;
    private bool isGenerating;
    private bool deepReview;
    private bool isSavingSelection;
    private bool isWorking => isAnalyzing || isGenerating;
    private string? errorMessage;
    private string? selectionError;

    private AngryFoot.Contracts.JobAnalysisDto? analysis;
    private AngryFoot.Contracts.EvidenceCoverageReportDto? coverage;
    private AngryFoot.Contracts.GenerationExplanationDto? explanation;

    // Analyze reports on the whole library; Generate reports on the bullets that made the resume.
    // Same panel, and the heading is what tells the two apart.
    private string coverageTitle = LibraryCoverageTitle;
    private const string LibraryCoverageTitle = "Evidence Coverage: Your Library Against This Posting";
    private const string ResumeCoverageTitle = "Evidence Coverage: This Resume Against This Posting";
    private AngryFoot.Contracts.OccupationBenchmarkDto? benchmark;
    private AngryFoot.Contracts.GenerationResultDto? result;
    private string? resumeVersionLabel;
    private string? coverLetterVersionLabel;

    private string GenerateProgressMessage => (isGeneric, deepReview) switch
    {
        (true, true) => "Generating with deep review: ranking your library for strength and breadth, rewriting the bullets, then critiquing, revising, and merging the versions. Expect a couple of minutes.",
        (true, false) => "Generating a generic resume: ranking your library for strength and breadth, then rewriting the bullets for your chosen reader. This typically takes 30-60 seconds.",
        (false, true) => "Generating with deep review: analyzing the job, ranking and rewriting bullets, then critiquing, revising, and merging both documents. Expect several minutes.",
        (false, false) => "Generating your tailored resume and cover letter: analyzing the job, ranking and rewriting bullets, then drafting documents. This typically takes 30-90 seconds."
    };

    /// <summary>
    /// Switching mode clears the previous result for the same reason a new Analyze does: a resume
    /// drafted the other way must not sit under controls that no longer describe it.
    /// </summary>
    private void SetGeneric(bool value)
    {
        isGeneric = value;
        result = null;
        analysis = null;
        coverage = null;
        explanation = null;
        benchmark = null;
        errorMessage = null;
        selectionError = null;
    }

    private string ResumeMarkdown =>
        VersionText(result?.ResumeRefinement, resumeVersionLabel) ?? result?.ResumeMarkdown ?? string.Empty;

    private string CoverLetterMarkdown =>
        VersionText(result?.CoverLetterRefinement, coverLetterVersionLabel) ?? result?.CoverLetterMarkdown ?? string.Empty;

    private static string? VersionText(AngryFoot.Contracts.RefinementDto? refinement, string? label)
        => refinement?.Versions.FirstOrDefault(x => x.Label == label)?.Text;

    private async Task AnalyzeAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        // Same reasoning as GenerateAsync: a resume drafted for the previous job must not sit
        // under an assessment of this one.
        result = null;

        isAnalyzing = true;
        try
        {
            var evidenceAnalysis = await ApiClient.AnalyzeJobAsync(jobDescription.Trim(), jobTitle?.Trim());
            analysis = evidenceAnalysis.Job;
            coverage = evidenceAnalysis.Coverage;
            coverageTitle = LibraryCoverageTitle;
            // Analyze picks no bullets, so there are no decisions to explain.
            explanation = null;
            benchmark = evidenceAnalysis.Benchmark;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task GenerateAsync()
    {
        errorMessage = null;

        if (!isGeneric && string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        // Generation re-analyzes the job but produces no benchmark, and its coverage report covers
        // the resume rather than the library, so anything on screen from a previous Analyze
        // belongs to whatever job was in the form then - not this one.
        coverage = null;
        explanation = null;
        benchmark = null;
        selectionError = null;

        isGenerating = true;
        try
        {
            if (isGeneric)
            {
                result = await ApiClient.GenerateGenericAsync(new AngryFoot.Contracts.GenericGenerationRequest(
                    audience,
                    jobTitle?.Trim(),
                    maxBullets,
                    deepReview,
                    guidance?.Trim()));

                // The neutral analysis a generic generation carries has nothing in it, and an empty
                // "Extracted Job Requirements" panel would imply a posting was read and found bare.
                analysis = null;
            }
            else
            {
                result = await ApiClient.GenerateAsync(new AngryFoot.Contracts.GenerationRequest(
                    jobDescription.Trim(),
                    jobTitle?.Trim(),
                    company?.Trim(),
                    maxBullets,
                    deepReview,
                    guidance?.Trim()));

                analysis = result.Analysis;
            }

            resultIsGeneric = isGeneric;
            coverage = result.Coverage;
            coverageTitle = ResumeCoverageTitle;
            explanation = result.Explanation;
            resumeVersionLabel = result.ResumeRefinement?.RecommendedLabel;
            coverLetterVersionLabel = result.CoverLetterRefinement?.RecommendedLabel;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task OnResumeVersionSelected(string label)
    {
        resumeVersionLabel = label;
        await SaveSelectionAsync();
    }

    private async Task OnCoverLetterVersionSelected(string label)
    {
        coverLetterVersionLabel = label;
        await SaveSelectionAsync();
    }

    /// <summary>
    /// Writes the chosen versions back to the stored generation, so History shows what the user
    /// picked here rather than whatever the arbiter happened to recommend.
    /// </summary>
    private async Task SaveSelectionAsync()
    {
        if (result is null)
        {
            return;
        }

        selectionError = null;
        isSavingSelection = true;

        try
        {
            await ApiClient.SelectArtifactVersionsAsync(result.ArtifactId, resumeVersionLabel, coverLetterVersionLabel);
        }
        catch (Exception ex)
        {
            // The selection still applies on screen; only the saved copy is stale.
            selectionError = $"Showing your selection, but it could not be saved to history: {ex.Message}";
        }
        finally
        {
            isSavingSelection = false;
        }
    }

    private async Task CopyResumeAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ResumeMarkdown);
        }
    }

    private async Task CopyCoverLetterAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", CoverLetterMarkdown);
        }
    }
}
