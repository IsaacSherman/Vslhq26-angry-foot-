@page "/generate"
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Generate</PageTitle>

<h1>Generate Resume & Cover Letter</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Job Title (optional)</label>
                <input class="form-control" @bind="jobTitle" />
                <div class="form-text">Used to map the role to an occupation for the benchmark below.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Company (optional)</label>
                <input class="form-control" @bind="company" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Max Bullets</label>
                <input class="form-control" type="number" min="1" max="20" @bind="maxBullets" />
            </div>
            <div class="col-12">
                <label class="form-label">Job Description</label>
                <textarea class="form-control" rows="10" @bind="jobDescription"></textarea>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-secondary me-2" @onclick="AnalyzeAsync" disabled="@isWorking">
                @if (isAnalyzing)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Analyze
            </button>
            <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@isWorking">
                @if (isGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Generate
            </button>
        </div>
    </div>
</div>

<WorkingIndicator Visible="@isAnalyzing" Message="Analyzing the job and assessing your fit against your bullet library. This usually takes under a minute." />
<WorkingIndicator Visible="@isGenerating" Message="Generating your tailored resume and cover letter: analyzing the job, ranking and rewriting bullets, then drafting documents. This typically takes 30-90 seconds." />

@if (fit is not null)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Your Fit for This Role</span>
            <span class="badge @FitBadgeClass(fit.FitScore)">Fit Score: @fit.FitScore / 100</span>
        </div>
        <div class="card-body">
            <div class="progress mb-3" role="progressbar" aria-label="Fit score" aria-valuenow="@fit.FitScore" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar @FitBarClass(fit.FitScore)" style="width: @(fit.FitScore)%"></div>
            </div>

            <p class="lead">@fit.Verdict</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <h6 class="text-success">Strengths</h6>
                    @if (fit.Strengths.Count == 0)
                    {
                        <p class="text-muted">No clear strengths found for this role's requirements.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var strength in fit.Strengths)
                            {
                                <li class="mb-1">&#10003; @strength</li>
                            }
                        </ul>
                    }
                </div>
                <div class="col-md-6">
                    <h6 class="text-danger">Gaps</h6>
                    @if (fit.Gaps.Count == 0)
                    {
                        <p class="text-muted">No significant gaps identified.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var gap in fit.Gaps)
                            {
                                <li class="mb-1">&#10007; @gap</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (fit.BulletSuggestions.Count > 0)
            {
                <hr />
                <h6>Focus new bullets on</h6>
                <ol class="mb-0">
                    @foreach (var suggestion in fit.BulletSuggestions)
                    {
                        <li>@suggestion</li>
                    }
                </ol>
            }
        </div>
    </div>
}

<OccupationBenchmarkPanel Benchmark="@benchmark" />

@if (analysis is not null)
{
    <details class="card mb-3">
        <summary class="card-header" style="cursor: pointer;">Extracted Job Requirements</summary>
        <div class="card-body">
            <p><strong>Inferred Title:</strong> @analysis.InferredTitle</p>
            <p><strong>Inferred Seniority:</strong> @analysis.InferredSeniority</p>
            <p><strong>Required Skills:</strong> @string.Join(", ", analysis.RequiredSkills)</p>
            <p><strong>Preferred Skills:</strong> @string.Join(", ", analysis.PreferredSkills)</p>
            <p><strong>Technologies:</strong> @string.Join(", ", analysis.Technologies)</p>
            <p><strong>Experience Themes:</strong> @string.Join(", ", analysis.ExperienceThemes)</p>
        </div>
    </details>
}

@if (result is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="mb-0">Generated Output</h3>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CopyResumeAsync">Copy Resume</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CopyCoverLetterAsync">Copy Cover Letter</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <MarkdownPane Title="Resume" Markdown="@result.ResumeMarkdown" Rows="24" />
        </div>
        <div class="col-md-6">
            <MarkdownPane Title="Cover Letter" Markdown="@result.CoverLetterMarkdown" Rows="24" />
        </div>
    </div>
}

@code {
    private string? jobTitle;
    private string? company;
    private string jobDescription = string.Empty;
    private int maxBullets = 10;

    private bool isAnalyzing;
    private bool isGenerating;
    private bool isWorking => isAnalyzing || isGenerating;
    private string? errorMessage;

    private AngryFoot.Contracts.JobAnalysisDto? analysis;
    private AngryFoot.Contracts.FitAssessmentDto? fit;
    private AngryFoot.Contracts.OccupationBenchmarkDto? benchmark;
    private AngryFoot.Contracts.GenerationResultDto? result;

    private static string FitBadgeClass(int score) => score switch
    {
        >= 75 => "text-bg-success",
        >= 50 => "text-bg-warning",
        _ => "text-bg-danger"
    };

    private static string FitBarClass(int score) => score switch
    {
        >= 75 => "bg-success",
        >= 50 => "bg-warning",
        _ => "bg-danger"
    };

    private async Task AnalyzeAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        // Same reasoning as GenerateAsync: a resume drafted for the previous job must not sit
        // under an assessment of this one.
        result = null;

        isAnalyzing = true;
        try
        {
            var fitAnalysis = await ApiClient.AnalyzeJobAsync(jobDescription.Trim(), jobTitle?.Trim());
            analysis = fitAnalysis.Job;
            fit = fitAnalysis.Fit;
            benchmark = fitAnalysis.Benchmark;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task GenerateAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        // Generation re-analyzes the job but produces no fit or benchmark, so anything on screen
        // from a previous Analyze belongs to whatever job was in the form then - not this one.
        fit = null;
        benchmark = null;

        isGenerating = true;
        try
        {
            result = await ApiClient.GenerateAsync(new AngryFoot.Contracts.GenerationRequest(
                jobDescription.Trim(),
                jobTitle?.Trim(),
                company?.Trim(),
                maxBullets));

            analysis = result.Analysis;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task CopyResumeAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", result.ResumeMarkdown);
        }
    }

    private async Task CopyCoverLetterAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", result.CoverLetterMarkdown);
        }
    }
}
