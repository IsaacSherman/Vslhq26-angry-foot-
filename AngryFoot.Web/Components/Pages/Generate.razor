@page "/generate"
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Generate</PageTitle>

<h1>Generate Resume & Cover Letter</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Job Title (optional)</label>
                <input class="form-control" @bind="jobTitle" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Company (optional)</label>
                <input class="form-control" @bind="company" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Max Bullets</label>
                <input class="form-control" type="number" min="1" max="20" @bind="maxBullets" />
            </div>
            <div class="col-12">
                <label class="form-label">Job Description</label>
                <textarea class="form-control" rows="10" @bind="jobDescription"></textarea>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-secondary me-2" @onclick="AnalyzeAsync" disabled="@isWorking">Analyze</button>
            <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@isWorking">Generate</button>
        </div>
    </div>
</div>

@if (analysis is not null)
{
    <div class="card mb-3">
        <div class="card-header">Job Analysis</div>
        <div class="card-body">
            <p><strong>Inferred Title:</strong> @analysis.InferredTitle</p>
            <p><strong>Inferred Seniority:</strong> @analysis.InferredSeniority</p>
            <p><strong>Required Skills:</strong> @string.Join(", ", analysis.RequiredSkills)</p>
            <p><strong>Preferred Skills:</strong> @string.Join(", ", analysis.PreferredSkills)</p>
            <p><strong>Technologies:</strong> @string.Join(", ", analysis.Technologies)</p>
            <p><strong>Experience Themes:</strong> @string.Join(", ", analysis.ExperienceThemes)</p>
        </div>
    </div>
}

@if (result is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="mb-0">Generated Output</h3>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CopyResumeAsync">Copy Resume</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CopyCoverLetterAsync">Copy Cover Letter</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <MarkdownPane Title="Resume" Markdown="@result.ResumeMarkdown" Rows="24" />
        </div>
        <div class="col-md-6">
            <MarkdownPane Title="Cover Letter" Markdown="@result.CoverLetterMarkdown" Rows="24" />
        </div>
    </div>
}

@code {
    private string? jobTitle;
    private string? company;
    private string jobDescription = string.Empty;
    private int maxBullets = 10;

    private bool isWorking;
    private string? errorMessage;

    private AngryFoot.Contracts.JobAnalysisDto? analysis;
    private AngryFoot.Contracts.GenerationResultDto? result;

    private async Task AnalyzeAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        isWorking = true;
        try
        {
            analysis = await ApiClient.AnalyzeJobAsync(jobDescription.Trim());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task GenerateAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            errorMessage = "Job description is required.";
            return;
        }

        isWorking = true;
        try
        {
            result = await ApiClient.GenerateAsync(new AngryFoot.Contracts.GenerationRequest(
                jobDescription.Trim(),
                jobTitle?.Trim(),
                company?.Trim(),
                maxBullets));

            analysis = result.Analysis;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task CopyResumeAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", result.ResumeMarkdown);
        }
    }

    private async Task CopyCoverLetterAsync()
    {
        if (result is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", result.CoverLetterMarkdown);
        }
    }
}
