@page "/"
@using AngryFoot.Contracts
@using AngryFoot.Web.Services
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject ILogger<Home> Logger

<PageTitle>AngryFoot</PageTitle>

<div class="px-4 py-4 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-5 fw-bold">AngryFoot</h1>
    <p class="col-lg-9 fs-5 mb-0">
        Build a library of achievement bullets, let AI enrich them with skills and impact metadata,
        then generate a resume and cover letter tailored to any job description &mdash; with every
        requirement traced back to the bullets that evidence it.
    </p>
</div>

@if (aiStatus is not null)
{
    @if (aiStatus.IsHealthy)
    {
        <div class="alert alert-success py-2">
            <span class="bi bi-check-circle me-1" aria-hidden="true"></span>
            <strong>AI connected.</strong> @aiStatus.Message
        </div>
    }
    else
    {
        <div class="alert alert-warning py-2">
            <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
            <strong>AI is not configured.</strong> Everything still works using built-in heuristics,
            but enrichment, evidence review, and generation are better with AI. @aiStatus.Message
        </div>
    }
}

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><span class="badge text-bg-secondary me-2">1</span>Profile</h5>
                <p class="card-text flex-grow-1">
                    Enter your contact details, work history, education, and certifications once.
                    They frame every resume you generate.
                </p>
                <a class="btn btn-outline-primary" href="profile">Set up profile</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><span class="badge text-bg-secondary me-2">2</span>Bullets</h5>
                <p class="card-text flex-grow-1">
                    Capture your achievements as bullets. AI tags each one with skills, technologies,
                    and impact so the generator can find your best material.
                    @if (bulletCount is not null)
                    {
                        <br />
                        <span class="text-muted">@bulletCount bullet@(bulletCount == 1 ? "" : "s") in your library.</span>
                    }
                </p>
                <a class="btn btn-outline-primary" href="bullets">Manage bullets</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><span class="badge text-bg-secondary me-2">3</span>Generate</h5>
                <p class="card-text flex-grow-1">
                    Paste a job description to see which of its requirements your bullets evidence,
                    which they only mention, and which they miss &mdash; then generate a tailored
                    resume and cover letter in Markdown.
                </p>
                <a class="btn btn-primary" href="generate">Analyze &amp; generate</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><span class="badge text-bg-secondary me-2">4</span>History</h5>
                <p class="card-text flex-grow-1">
                    Every generation is saved with the job description it targeted, so you can
                    revisit, copy, or compare past applications.
                    @if (artifactCount is not null)
                    {
                        <br />
                        <span class="text-muted">@artifactCount saved generation@(artifactCount == 1 ? "" : "s").</span>
                    }
                </p>
                <a class="btn btn-outline-primary" href="history">Browse history</a>
            </div>
        </div>
    </div>
</div>

@code {
    private AiStatusResponse? aiStatus;
    private int? bulletCount;
    private int? artifactCount;

    protected override async Task OnInitializedAsync()
    {
        // Each fetch is best-effort; the start page should render even if the API is unreachable.
        aiStatus = await ApiClient.GetAiStatusAsync();

        try
        {
            bulletCount = (await ApiClient.GetBulletsAsync(null, null, null, null, null)).Count;
            artifactCount = (await ApiClient.GetArtifactsAsync()).Count;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load library counts for the start page.");
        }
    }
}
