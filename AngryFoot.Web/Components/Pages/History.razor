@page "/history"
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>History</PageTitle>

<h1>Generation History</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else if (artifacts.Count == 0)
{
    <p>No generated artifacts yet.</p>
}
else
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="list-group">
                @foreach (var item in artifacts)
                {
                    <button class="list-group-item list-group-item-action @(selectedId == item.Id ? "active" : null)" @onclick="() => SelectAsync(item.Id)">
                        <div><strong>@Title(item.JobTitle, item.IsGeneric)</strong></div>
                        <div>@(item.IsGeneric ? AudienceLine(item.Audience) : item.Company)</div>
                        <small>@item.CreatedDate.ToLocalTime()</small>
                    </button>
                }
            </div>
        </div>

        <div class="col-md-8">
            @if (selectedArtifact is null)
            {
                <p>Select a generation.</p>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="mb-0">@Title(selectedArtifact.JobTitle, selectedArtifact.IsGeneric)</h3>
                    <div>
                        <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CopyResumeAsync">Copy Resume</button>
                        @if (!selectedArtifact.IsGeneric)
                        {
                            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CopyCoverLetterAsync">Copy Cover Letter</button>
                        }
                        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedAsync">Delete</button>
                    </div>
                </div>

                @if (selectedArtifact.IsGeneric)
                {
                    <p><strong>Written for:</strong> @AudienceLine(selectedArtifact.Audience)</p>
                }
                else
                {
                    <p><strong>Company:</strong> @selectedArtifact.Company</p>
                }
                <p><strong>Created:</strong> @selectedArtifact.CreatedDate.ToLocalTime()</p>

                @* Nothing to show for a generic generation: there was no posting. *@
                @if (!selectedArtifact.IsGeneric)
                {
                    <label class="form-label">Original Job Description</label>
                    <textarea class="form-control mb-3" rows="6" readonly>@selectedArtifact.JobDescription</textarea>
                }

                @* Null for artifacts generated before coverage was recorded; the panel renders nothing. *@
                <EvidenceCoveragePanel Coverage="@selectedArtifact.Coverage"
                                       Title="Evidence Coverage when this resume was generated" />

                <GenerationExplanationPanel Explanation="@selectedArtifact.Explanation"
                                            Title="Why this resume held these bullets"
                                            IsGeneric="@selectedArtifact.IsGeneric" />

                <div class="row g-3">
                    <div class="@(selectedArtifact.IsGeneric ? "col-12" : "col-md-6")">
                        <DraftVersionPicker Refinement="@selectedArtifact.ResumeRefinement"
                                            Title="Deep review: pick a resume"
                                            SelectedLabel="@selectedArtifact.ResumeRefinement?.RecommendedLabel"
                                            Disabled="@isSavingSelection"
                                            SelectedLabelChanged="OnResumeVersionSelected" />
                        <MarkdownPane Title="Resume" Markdown="@selectedArtifact.ResumeMarkdown" Rows="18" />
                    </div>
                    @if (!selectedArtifact.IsGeneric)
                    {
                        <div class="col-md-6">
                            <DraftVersionPicker Refinement="@selectedArtifact.CoverLetterRefinement"
                                                Title="Deep review: pick a cover letter"
                                                SelectedLabel="@selectedArtifact.CoverLetterRefinement?.RecommendedLabel"
                                                Disabled="@isSavingSelection"
                                                SelectedLabelChanged="OnCoverLetterVersionSelected" />
                            <MarkdownPane Title="Cover Letter" Markdown="@selectedArtifact.CoverLetterMarkdown" Rows="18" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly List<AngryFoot.Contracts.ArtifactSummaryDto> artifacts = [];
    private AngryFoot.Contracts.GenerationArtifactDto? selectedArtifact;
    private Guid? selectedId;

    private bool isLoading;
    private bool isSavingSelection;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    /// <summary>
    /// A generic generation's title is the role the candidate was aiming at, not one a posting
    /// advertised, so it is labelled as such rather than shown as if a job had been applied to.
    /// </summary>
    private static string Title(string? jobTitle, bool isGeneric)
    {
        if (!isGeneric)
        {
            return string.IsNullOrWhiteSpace(jobTitle) ? "Untitled Role" : jobTitle;
        }

        return string.IsNullOrWhiteSpace(jobTitle)
            ? "Generic resume"
            : $"Generic resume - {jobTitle}";
    }

    private static string AudienceLine(AngryFoot.Contracts.ResumeAudienceDto? audience) => audience switch
    {
        AngryFoot.Contracts.ResumeAudienceDto.Recruiter => "Recruiters",
        AngryFoot.Contracts.ResumeAudienceDto.HiringManager => "Hiring managers",
        AngryFoot.Contracts.ResumeAudienceDto.TechnicalLeader => "Technical managers and leads",
        AngryFoot.Contracts.ResumeAudienceDto.Executive => "Executives",
        AngryFoot.Contracts.ResumeAudienceDto.Verbatim => "Nobody in particular - printed verbatim",
        // Recorded under a name this build no longer has, or before audiences were stored.
        _ => "A general audience"
    };

    private async Task LoadAsync()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            artifacts.Clear();
            artifacts.AddRange(await ApiClient.GetArtifactsAsync());

            if (artifacts.Count > 0)
            {
                await SelectAsync(artifacts[0].Id);
            }
            else
            {
                selectedArtifact = null;
                selectedId = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectAsync(Guid id)
    {
        selectedId = id;
        selectedArtifact = await ApiClient.GetArtifactAsync(id);
    }

    private Task OnResumeVersionSelected(string label) => SelectVersionAsync(label, null);

    private Task OnCoverLetterVersionSelected(string label) => SelectVersionAsync(null, label);

    private async Task SelectVersionAsync(string? resumeLabel, string? coverLetterLabel)
    {
        if (selectedId is null)
        {
            return;
        }

        errorMessage = null;
        isSavingSelection = true;

        try
        {
            // The response carries the promoted markdown, so the panes update from the server's
            // copy rather than a local guess at what it now holds.
            selectedArtifact = await ApiClient.SelectArtifactVersionsAsync(selectedId.Value, resumeLabel, coverLetterLabel)
                ?? selectedArtifact;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSavingSelection = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (selectedId is null)
        {
            return;
        }

        await ApiClient.DeleteArtifactAsync(selectedId.Value);
        await LoadAsync();
    }

    private async Task CopyResumeAsync()
    {
        if (selectedArtifact is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", selectedArtifact.ResumeMarkdown);
        }
    }

    private async Task CopyCoverLetterAsync()
    {
        if (selectedArtifact is not null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", selectedArtifact.CoverLetterMarkdown);
        }
    }
}
