@page "/bullets"
@inject AngryFoot.Web.Services.ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Bullets</PageTitle>

<h1>Bullets</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="CreateNew">Add Bullet</button>
    <button class="btn btn-outline-primary ms-2" @onclick="ImportResume">Import Resume</button>
    @if (retrievalEnabled && bullets.Any(b => !b.IsIndexed))
    {
        <button class="btn btn-outline-warning ms-2" @onclick="IndexAllMissingAsync" disabled="@(isBulkIndexing || indexingId is not null)">
            @if (isBulkIndexing)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            Index All Missing
        </button>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <input class="form-control" placeholder="Search text" @bind="search" />
            </div>
            <div class="col-md-2">
                <input class="form-control" placeholder="Tag" @bind="tag" />
            </div>
            <div class="col-md-2">
                <input class="form-control" placeholder="Skill" @bind="skill" />
            </div>
            <div class="col-md-2">
                <input class="form-control" placeholder="Technology" @bind="technology" />
            </div>
            <div class="col-md-2">
                <input class="form-control" placeholder="Category" @bind="category" />
            </div>
        </div>
        <div class="mt-2">
            <button class="btn btn-secondary me-2" @onclick="LoadAsync">Apply Filters</button>
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (bullets.Count == 0)
{
    <p>No bullets found.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Bullet</th>
                <th>Employer</th>
                <th>Skills</th>
                <th>Technologies</th>
                <th>State</th>
                <th style="width: 260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bullet in bullets)
            {
                <tr>
                    <td>@bullet.BulletText</td>
                    <td>@(bullet.SourceEmployer ?? "—")</td>
                    <td>@string.Join(", ", bullet.Skills)</td>
                    <td>@string.Join(", ", bullet.Technologies)</td>
                    <td>@bullet.EnrichmentState</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(bullet.Id)" disabled="@(enrichingId == bullet.Id)">Edit</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => EnrichAsync(bullet.Id)" disabled="@(enrichingId is not null)">
                            @if (enrichingId == bullet.Id)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            Retry Enrich
                        </button>
                        @if (retrievalEnabled && !bullet.IsIndexed)
                        {
                            <button class="btn btn-sm btn-outline-warning me-1" title="Not yet in the semantic search index" @onclick="() => IndexAsync(bullet.Id)" disabled="@(indexingId is not null || isBulkIndexing)">
                                @if (indexingId == bullet.Id)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                Add to Vector Index
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(bullet.Id)" disabled="@(enrichingId == bullet.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<AngryFoot.Contracts.BulletDto> bullets = [];
    private bool isLoading;
    private string? errorMessage;
    private string? successMessage;

    private string? search;
    private string? tag;
    private string? skill;
    private string? technology;
    private string? category;
    private Guid? enrichingId;
    private Guid? indexingId;
    private bool isBulkIndexing;
    private bool retrievalEnabled;

    protected override async Task OnInitializedAsync()
    {
        var aiStatus = await ApiClient.GetAiStatusAsync();
        retrievalEnabled = aiStatus?.RetrievalEnabled ?? false;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            bullets.Clear();
            bullets.AddRange(await ApiClient.GetBulletsAsync(search, tag, skill, technology, category));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/bullets/edit");
    }

    private void ImportResume()
    {
        Navigation.NavigateTo("/bullets/import");
    }

    private void Edit(Guid id)
    {
        Navigation.NavigateTo($"/bullets/edit/{id}");
    }

    private async Task EnrichAsync(Guid id)
    {
        errorMessage = null;
        enrichingId = id;

        try
        {
            await ApiClient.EnrichBulletAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            enrichingId = null;
        }
    }

    private async Task IndexAsync(Guid id)
    {
        errorMessage = null;
        indexingId = id;

        try
        {
            await ApiClient.IndexBulletAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            indexingId = null;
        }
    }

    private async Task IndexAllMissingAsync()
    {
        errorMessage = null;
        isBulkIndexing = true;

        try
        {
            var missingBefore = bullets.Count(b => !b.IsIndexed);
            var indexedCount = await ApiClient.IndexMissingBulletsAsync();
            await LoadAsync();
            successMessage = indexedCount == 0
                ? "No bullets needed indexing."
                : $"Indexed {indexedCount} of {missingBefore} bullet{(missingBefore == 1 ? "" : "s")}.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBulkIndexing = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteBulletAsync(id);
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        search = null;
        tag = null;
        skill = null;
        technology = null;
        category = null;
        await LoadAsync();
    }
}
