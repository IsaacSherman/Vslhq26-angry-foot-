@page "/review"
@using AngryFoot.Contracts
@inject AngryFoot.Web.Services.ApiClient ApiClient

<PageTitle>Review a Resume</PageTitle>

<h1>Review a Resume</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (report is null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Upload or paste a resume</h5>
            <p class="mb-0">
                We'll read the document and say what we find: what the bullets do and don't establish,
                and what would settle each one. <strong>Nothing is saved</strong> &mdash; the resume is
                read to answer this request and then discarded.
            </p>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="review-file">Upload a @ImportLimits.DescribeResumeFormats() file</label>
        @if (fileImportEnabled)
        {
            <InputFile id="review-file" class="form-control" accept="@ImportLimits.ResumeFileAccept"
                       OnChange="HandleFileSelectedAsync" disabled="@isReviewing" />
        }
        else
        {
            <InputFile id="review-file" class="form-control" accept="@ImportLimits.ResumeFileAccept" disabled="true" />
            <div class="alert alert-warning mt-2 mb-0">
                @(fileImportMessage ?? "File upload is unavailable right now.") Paste the resume text below instead.
            </div>
        }
    </div>

    <p class="text-body-secondary">or</p>

    <div class="mb-3">
        <textarea class="form-control" rows="14" placeholder="Paste resume text here..."
                  @bind="resumeText" @bind:event="oninput" disabled="@isReviewing"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label" for="review-posting">Target job description (optional)</label>
        <textarea id="review-posting" class="form-control" rows="5"
                  placeholder="Paste a posting to also see what this resume evidences against it..."
                  @bind="jobDescription" @bind:event="oninput" disabled="@isReviewing"></textarea>
    </div>

    <button class="btn btn-primary" @onclick="ReviewPastedAsync"
            disabled="@(isReviewing || string.IsNullOrWhiteSpace(resumeText))">
        Review Resume
    </button>

    <WorkingIndicator Visible="@isReviewing" Message="Reading the resume" />
}
else
{
    <div class="alert alert-secondary">
        <span class="bi bi-shield-check me-1" aria-hidden="true"></span>
        Nothing from this resume was saved. Leaving this page discards it.
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-2">@report.Summary</p>
            <p class="text-body-secondary small mb-0">@report.Disclaimer</p>
        </div>
    </div>

    @if (report.SpotChecks.Count > 0)
    {
        <h2 class="h5">About the document</h2>
        @foreach (var check in report.SpotChecks)
        {
            <details class="card mb-2">
                <summary class="card-body py-2">
                    <span class="badge @CoverageBands.SeverityBadge(check.Severity) me-2">@CoverageBands.SeverityLabel(check.Severity)</span>
                    @check.Message
                </summary>
                <div class="card-body pt-0">
                    <EvidenceRationalePanel Why="check.Why" MissingHeading="What would settle this:" />
                </div>
            </details>
        }
    }

    <h2 class="h5 mt-4">Bullet by bullet</h2>
    @if (report.Bullets.Count == 0)
    {
        <p class="text-body-secondary">No achievement bullets were found in this document.</p>
    }
    @foreach (var bullet in report.Bullets)
    {
        <div class="card mb-2">
            <div class="card-body">
                <p class="mb-1">@bullet.Text</p>
                @if (!string.IsNullOrWhiteSpace(bullet.Employer))
                {
                    <p class="text-body-secondary small mb-2">@bullet.Employer</p>
                }

                @if (bullet.Findings.Count == 0 && bullet.Suggestions.Count == 0)
                {
                    <p class="text-body-secondary small mb-0">No checks flagged this bullet.</p>
                }

                @foreach (var suggestion in bullet.Suggestions)
                {
                    <div class="alert alert-info py-2 mb-2">@suggestion</div>
                }

                @foreach (var finding in bullet.Findings)
                {
                    <details class="mb-2">
                        <summary>
                            <span class="badge @CoverageBands.SeverityBadge(finding.Severity) me-2">@CoverageBands.SeverityLabel(finding.Severity)</span>
                            @finding.Message
                        </summary>
                        <div class="mt-2">
                            <EvidenceRationalePanel Why="finding.Why" MissingHeading="What would settle this:" />
                        </div>
                    </details>
                }
            </div>
        </div>
    }

    @if (report.Coverage is not null)
    {
        <EvidenceCoveragePanel Coverage="report.Coverage" Title="Against the posting you pasted" />
    }

    <div class="mt-3 mb-5">
        <button class="btn btn-outline-secondary" @onclick="Reset">Review Another</button>
    </div>
}

@code {
    private string? resumeText;
    private string? jobDescription;
    private ResumeReviewReportDto? report;
    private bool isReviewing;
    private string? errorMessage;
    private bool fileImportEnabled;
    private string? fileImportMessage;

    protected override async Task OnInitializedAsync()
    {
        // Best-effort: an unreachable API leaves upload disabled, which is the safe reading of "we
        // could not confirm the converter is there", and pasting still works.
        var status = await ApiClient.GetAiStatusAsync();
        fileImportEnabled = status?.FileImportEnabled ?? false;
        fileImportMessage = status?.FileImportMessage;
    }

    private Task ReviewPastedAsync()
        => ReviewAsync(() => ApiClient.ReviewResumeAsync(resumeText!, jobDescription));

    private Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
        => ReviewAsync(async () =>
        {
            await using var stream = e.File.OpenReadStream(ImportLimits.MaxResumeFileSizeBytes);
            return await ApiClient.ReviewResumeFromFileAsync(stream, e.File.Name, jobDescription);
        });

    /// <summary>An uploaded file and pasted text differ only in how the report is fetched; what is
    /// rendered below knows nothing about which one produced it.</summary>
    private async Task ReviewAsync(Func<Task<ResumeReviewReportDto>> fetch)
    {
        errorMessage = null;
        isReviewing = true;

        try
        {
            report = await fetch();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isReviewing = false;
        }
    }

    private void Reset()
    {
        report = null;
        errorMessage = null;
    }
}
