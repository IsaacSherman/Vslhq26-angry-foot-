@page "/profile"
@inject AngryFoot.Web.Services.ApiClient ApiClient

<PageTitle>Profile</PageTitle>

<h1>Profile</h1>

<p><a href="/profile/import">Import from LinkedIn</a></p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (model is null)
{
    <p>Loading...</p>
}
else
{
    <ProfileEditor Model="model" />

    <div>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">Save Profile</button>
    </div>
}

@code {
    private EditableProfile? model;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ApiClient.GetProfileAsync();
            model = EditableProfile.FromDto(profile);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (model is null)
        {
            return;
        }

        errorMessage = null;
        isSaving = true;

        try
        {
            var saved = await ApiClient.SaveProfileAsync(model.ToDto());
            model = EditableProfile.FromDto(saved);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
