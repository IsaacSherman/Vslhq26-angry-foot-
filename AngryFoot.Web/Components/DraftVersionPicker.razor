@using AngryFoot.Contracts

@* Lets the user choose between the versions produced by a deep review pass. Renders nothing
   when the content was generated without deep review. *@

@if (Refinement is not null && Refinement.Versions.Count > 0)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@Title</span>
            <span class="badge text-bg-secondary">@Refinement.Versions.Count versions</span>
        </div>
        <div class="card-body">
            @foreach (var version in Refinement.Versions)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="radio"
                           name="@groupName"
                           id="@($"{groupName}-{version.Label}")"
                           checked="@(version.Label == SelectedLabel)"
                           disabled="@Disabled"
                           @onchange="@(() => SelectAsync(version.Label))" />
                    <label class="form-check-label" for="@($"{groupName}-{version.Label}")">
                        <span class="badge text-bg-light font-monospace me-1">@version.Label</span>
                        <strong>@version.Title</strong>
                        @if (version.Label == Refinement.RecommendedLabel)
                        {
                            <span class="badge text-bg-success ms-1">Recommended</span>
                        }
                        <div class="form-text mt-0">@version.Rationale</div>
                    </label>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Refinement.Critique))
            {
                <details class="mt-2">
                    <summary style="cursor: pointer;">What the reviewer said about the first draft</summary>
                    <p class="mt-2 mb-0" style="white-space: pre-wrap;">@Refinement.Critique</p>
                </details>
            }
        </div>
    </div>
}

@code {
    [Parameter] public RefinementDto? Refinement { get; set; }
    [Parameter] public string Title { get; set; } = "Deep review versions";
    [Parameter] public string? SelectedLabel { get; set; }
    [Parameter] public EventCallback<string> SelectedLabelChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    // Radio groups are keyed by name, so two pickers on one page must not share it.
    private readonly string groupName = $"versions-{Guid.NewGuid():N}";

    private async Task SelectAsync(string label)
    {
        if (label == SelectedLabel)
        {
            return;
        }

        SelectedLabel = label;
        await SelectedLabelChanged.InvokeAsync(label);
    }
}
